# Application
NODE_ENV=development
PORT=3000
# Comma-separated allowed origins for the frontend (unset = allow all, dev only)
CORS_ORIGINS=http://localhost:5173

# PostgreSQL (13+; uses built-in gen_random_uuid())
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=your_database_password
DB_DATABASE=medipulse_db
DB_LOGGING=false

# Auth (use a long random value, e.g. `openssl rand -hex 32`)
JWT_SECRET=change_me_to_a_long_random_secret
# Token lifetime in seconds
JWT_EXPIRES_IN=3600

# Where prescription PDFs and test reports are stored (keep out of Git)
UPLOAD_DIR=uploads

# Only used by `npm run seed:admin`
SEED_ADMIN_EMAIL=admin@medipulse.local
SEED_ADMIN_PASSWORD=change_me_min_8_chars
SEED_ADMIN_NAME=System Admin

# Only used by `npm run seed:demo` (password for every demo account)
SEED_DEMO_PASSWORD=change_me_min_8_chars

# Email (SMTP). Leave MAIL_HOST empty and emails are only printed to the log.
# For testing use a Mailtrap sandbox inbox: Email Testing > Inboxes > SMTP.
MAIL_HOST=
MAIL_PORT=2525
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM="MediPulse <no-reply@medipulse.local>"
