<html lang='en'>
  <body
    style='margin:0;padding:0;background:#f3f5f7;font-family:Arial,Helvetica,sans-serif;color:#1f2933;'
  >
    <table
      role='presentation'
      width='100%'
      cellpadding='0'
      cellspacing='0'
      style='background:#f3f5f7;padding:24px 0;'
    >
      <tr>
        <td align='center'>
          <table
            role='presentation'
            width='560'
            cellpadding='0'
            cellspacing='0'
            style='background:#ffffff;border-radius:8px;overflow:hidden;'
          >
            <tr>
              <td
                style='background:#0f766e;color:#ffffff;padding:18px 28px;font-size:20px;font-weight:bold;'
              >{{appName}}</td>
            </tr>
            <tr>
              <td style='padding:28px;font-size:15px;line-height:1.55;'>
                <h2 style="margin:0 0 12px;font-size:20px;">Reset your password</h2>
                <p style="margin:0 0 12px;">Hi {{name}}, we received a request to reset the password for your {{appName}} account.</p>
                <p style="margin:20px 0;">
                  <a href="{{resetLink}}" style="background:#0f766e;color:#ffffff;text-decoration:none;padding:12px 22px;border-radius:6px;font-weight:bold;display:inline-block;">Reset password</a>
                </p>
                <p style="margin:0 0 12px;">This link works <strong>once</strong> and expires in <strong>{{minutes}} minutes</strong>.</p>
                <p style="margin:0 0 12px;color:#6b7280;font-size:13px;">If the button does not work, copy this link into your browser:<br /><span style="word-break:break-all;">{{resetLink}}</span></p>
                <p style="margin:0 0 12px;color:#6b7280;font-size:13px;">Reset code (for testing the API): <span style="font-family:monospace;word-break:break-all;">{{token}}</span></p>
                <p style="margin:0;">If you did not ask for this, ignore this email. Your password will not change.</p>
              </td>
            </tr>
            <tr>
              <td
                style='padding:16px 28px;background:#f8fafc;color:#6b7280;font-size:12px;'
              >
                This is an automated message from
                {{appName}}. Please do not reply.<br />
                &copy;
                {{year}}
                {{appName}}
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>