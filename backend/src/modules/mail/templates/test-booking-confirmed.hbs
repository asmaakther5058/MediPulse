<html lang='en'>
  <body
    style='margin:0;padding:0;background:#f3f5f7;font-family:Arial,Helvetica,sans-serif;color:#1f2933;'
  >
    <table
      role='presentation'
      width='100%'
      cellpadding='0'
      cellspacing='0'
      style='background:#f3f5f7;padding:24px 0;'
    >
      <tr>
        <td align='center'>
          <table
            role='presentation'
            width='560'
            cellpadding='0'
            cellspacing='0'
            style='background:#ffffff;border-radius:8px;overflow:hidden;'
          >
            <tr>
              <td
                style='background:#0f766e;color:#ffffff;padding:18px 28px;font-size:20px;font-weight:bold;'
              >{{appName}}</td>
            </tr>
            <tr>
              <td style='padding:28px;font-size:15px;line-height:1.55;'>
                <h2 style='margin:0 0 12px;font-size:20px;'>Test booking
                  confirmed</h2>
                <p style='margin:0 0 12px;'>Hi
                  {{name}}, we received your payment and your diagnostic test is
                  booked.</p>
                <table
                  role='presentation'
                  cellpadding='0'
                  cellspacing='0'
                  style='width:100%;font-size:14px;border-top:1px solid #e5e7eb;'
                >
                  <tr><td
                      style='padding:6px 0;color:#6b7280;width:150px;'
                    >Test</td><td style='padding:6px 0;'>{{testName}}</td></tr>
                  <tr><td
                      style='padding:6px 0;color:#6b7280;width:150px;'
                    >Diagnostic center</td><td
                      style='padding:6px 0;'
                    >{{centerName}}</td></tr>
                  <tr><td
                      style='padding:6px 0;color:#6b7280;width:150px;'
                    >Address</td><td
                      style='padding:6px 0;'
                    >{{centerAddress}}</td></tr>
                  <tr><td
                      style='padding:6px 0;color:#6b7280;width:150px;'
                    >Date</td><td style='padding:6px 0;'>{{date}}</td></tr>
                </table>
                <h3 style='margin:24px 0 8px;font-size:16px;'>Payment receipt</h3>
                <table
                  role='presentation'
                  cellpadding='0'
                  cellspacing='0'
                  style='width:100%;font-size:14px;border-top:1px solid #e5e7eb;'
                >
                  <tr><td
                      style='padding:6px 0;color:#6b7280;width:150px;'
                    >Amount paid</td><td style='padding:6px 0;'><strong
                      >{{amount}} {{currency}}</strong></td></tr>
                  <tr><td
                      style='padding:6px 0;color:#6b7280;width:150px;'
                    >Payment method</td><td
                      style='padding:6px 0;'
                    >{{paymentMethod}}</td></tr>
                  <tr><td
                      style='padding:6px 0;color:#6b7280;width:150px;'
                    >Transaction ID</td><td
                      style='padding:6px 0;'
                    >{{transactionId}}</td></tr>
                  <tr><td style='padding:6px 0;color:#6b7280;width:150px;'>Paid
                      at</td><td style='padding:6px 0;'>{{paidAt}}</td></tr>
                </table>
              </td>
            </tr>
            <tr>
              <td
                style='padding:16px 28px;background:#f8fafc;color:#6b7280;font-size:12px;'
              >
                This is an automated message from
                {{appName}}. Please do not reply.<br />
                &copy;
                {{year}}
                {{appName}}
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>