<html lang='en'>
  <body
    style='margin:0;padding:0;background:#f3f5f7;font-family:Arial,Helvetica,sans-serif;color:#1f2933;'
  >
    <table
      role='presentation'
      width='100%'
      cellpadding='0'
      cellspacing='0'
      style='background:#f3f5f7;padding:24px 0;'
    >
      <tr>
        <td align='center'>
          <table
            role='presentation'
            width='560'
            cellpadding='0'
            cellspacing='0'
            style='background:#ffffff;border-radius:8px;overflow:hidden;'
          >
            <tr>
              <td
                style='background:#0f766e;color:#ffffff;padding:18px 28px;font-size:20px;font-weight:bold;'
              >{{appName}}</td>
            </tr>
            <tr>
              <td style='padding:28px;font-size:15px;line-height:1.55;'>
                <h2 style='margin:0 0 12px;font-size:20px;'>Your test report is
                  ready</h2>
                <p style='margin:0 0 12px;'>Hi
                  {{name}},
                  {{centerName}}
                  has completed your
                  <strong>{{testName}}</strong>
                  test ({{completedAt}}).</p>
                <p style='margin:0 0 12px;'>For your privacy, results are not
                  sent by email. Sign in to MediPulse to read the findings{{#if
                    hasFile
                  }} and download the report file{{/if}}. Your doctor can see it
                  too.</p>
              </td>
            </tr>
            <tr>
              <td
                style='padding:16px 28px;background:#f8fafc;color:#6b7280;font-size:12px;'
              >
                This is an automated message from
                {{appName}}. Please do not reply.<br />
                &copy;
                {{year}}
                {{appName}}
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>