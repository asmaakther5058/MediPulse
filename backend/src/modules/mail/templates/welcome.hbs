<html lang='en'>
  <body
    style='margin:0;padding:0;background:#f3f5f7;font-family:Arial,Helvetica,sans-serif;color:#1f2933;'
  >
    <table
      role='presentation'
      width='100%'
      cellpadding='0'
      cellspacing='0'
      style='background:#f3f5f7;padding:24px 0;'
    >
      <tr>
        <td align='center'>
          <table
            role='presentation'
            width='560'
            cellpadding='0'
            cellspacing='0'
            style='background:#ffffff;border-radius:8px;overflow:hidden;'
          >
            <tr>
              <td
                style='background:#0f766e;color:#ffffff;padding:18px 28px;font-size:20px;font-weight:bold;'
              >{{appName}}</td>
            </tr>
            <tr>
              <td style='padding:28px;font-size:15px;line-height:1.55;'>
                <h2 style='margin:0 0 12px;font-size:20px;'>Welcome,
                  {{name}}!</h2>
                <p style='margin:0 0 12px;'>Your
                  {{roleLabel}}
                  account has been created with the email
                  <strong>{{email}}</strong>.</p>
                {{#if isPatient}}
                  <p style='margin:0 0 12px;'>You can now find a doctor, book an
                    appointment and see your prescriptions and test reports in
                    one place.</p>
                {{/if}}
                {{#if isDoctor}}
                  <p style='margin:0 0 12px;'>Your profile is now
                    <strong>waiting for verification</strong>. We will notify
                    you as soon as an administrator approves it, and then you
                    can add your schedule.</p>
                {{/if}}
                {{#if isCenter}}
                <p style="margin:0 0 12px;">Your diagnostic center is now <strong>waiting for approval</strong>. Once an administrator approves it you can add tests, receive bookings and upload reports.</p>
                {{/if}}
                <p style='margin:0;'>If you did not create this account, please
                  contact us.</p>
              </td>
            </tr>
            <tr>
              <td
                style='padding:16px 28px;background:#f8fafc;color:#6b7280;font-size:12px;'
              >
                This is an automated message from
                {{appName}}. Please do not reply.<br />
                &copy;
                {{year}}
                {{appName}}
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>